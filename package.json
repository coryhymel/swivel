{
  "name": "swivel",
  "productName": "Swivel",
  "version": "0.1.0",
  "description": "Desktop switcher for Gmail, Google Calendar and Google Drive across multiple Google accounts.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js && node --check renderer/mock-api.js && node --check scripts/after-pack.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/enable-fuses.mjs"
  },
  "author": "Cory Hymel",
  "license": "MIT",
  "homepage": "https://github.com/coryhymel/swivel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coryhymel/swivel.git"
  },
  "bugs": {
    "url": "https://github.com/coryhymel/swivel/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "io.github.coryhymel.swivel",
    "productName": "Swivel",
    "copyright": "Copyright © 2026 Cory Hymel",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swivel",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Swivel-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "coryhymel",
      "repo": "swivel"
    }
  }
}
